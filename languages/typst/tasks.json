[
  {
    "label": "Typst: Export File",
    "command": "typst",
    "args": [
      "compile",
      "\"$ZED_FILE\""
    ],
    "hide": "on_success"
  },
  {
    "label": "Typst: Watch File",
    "command": "typst",
    "args": [
      "watch",
      "\"$ZED_FILE\""
    ],
    "reveal": "never",
    "hide": "always"
  }
]
